/* rofi Cyberpunk 2077 HUD theme — matches kitty/polybar/i3 palette */
configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    drun-display-format: "{name}";
    display-drun:        " ";
    display-run:         " ";
    display-window:      " ";
}

* {
    bg:        #0e0e17;
    bg-alt:    #121221;
    /* the game draws menu text in its HUD red, not in white */
    fg:        #ff6159;
    fg-dim:    #ae3b36;
    accent:    #ff6159;
    accent2:   #ff7167;
    /* selection is the game's hover: cyan text on a dark cyan field */
    select:    #5ef6ff;
    select-bg: #172c2e;

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    0;
    width:            560px;
    padding:          0;
}

mainbox {
    padding: 14px;
    spacing: 12px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    0;
    /* red stripe on the left edge, the way the in-game Arasaka terminals mark input */
    border:           0 0 0 3px;
    border-color:     @accent;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ entry ];
}

prompt {
    text-color: @accent;
}

entry {
    text-color:        @select;
    placeholder:       "search…";
    placeholder-color: @fg-dim;
    cursor:            text;
}

listview {
    lines:            8;
    columns:          1;
    fixed-height:     false;
    scrollbar:        false;
    spacing:          4px;
    background-color: @bg;
    text-color:       @fg;
}

element {
    padding:          8px 12px;
    spacing:          12px;
    border-radius:    0;
    /* same width as the selected stripe, so the text does not jump on hover */
    border:           0 0 0 3px;
    border-color:     @bg;
    background-color: @bg;
    text-color:       @fg;
}

/* все невыделенные состояния — светлый текст на тёмном фоне */
element normal.normal    { background-color: @bg; text-color: @fg; }
element normal.urgent    { background-color: @bg; text-color: @accent; }
element normal.active    { background-color: @bg; text-color: @accent2; }
element alternate.normal { background-color: @bg; text-color: @fg; }
element alternate.urgent { background-color: @bg; text-color: @accent; }
element alternate.active { background-color: @bg; text-color: @accent2; }

/* выделенное — как наведение в игре: бирюзовый текст и полоса слева */
element selected.normal  { background-color: @select-bg; text-color: @select; border: 0 0 0 3px; border-color: @select; }
element selected.urgent  { background-color: @select-bg; text-color: @select; border: 0 0 0 3px; border-color: @select; }
element selected.active  { background-color: @select-bg; text-color: @select; border: 0 0 0 3px; border-color: @select; }

element-icon {
    size:             1.2em;
    vertical-align:   0.5;
    background-color: transparent;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}
